{
  "id": "nodebb-plugin-inactive-users",
  "name": "Inactive Users",
  "description": "Email controls for inactive users with dryrun reports",
  "url": "https://github.com/MagicMirrorOrg/nodebb-plugin-inactive-users",
  "library": "./library.js",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:admin.header.build",
      "method": "addAdminNavigation"
    }
  ],
  "templates": "./templates",
  "settingsRoute": "/admin/plugins/inactive-users",
  "modules": {
    "../admin/plugins/inactive-users.js": "./public/admin.js"
  }
}
